# LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# SQLite path (default: ./helpdesk.db)
# HELPDESK_DB=./helpdesk.db

# Email notifications (optional — without SMTP a local .eml is still written)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
NOTIFY_EMAIL_TO=support@helpdesk.local
NOTIFY_EMAIL_FROM=agents@helpdesk.local

# HTTP webhook on agent completion (optional — JSON is always mirrored to disk)
# WEBHOOK_URL=https://example.com/hooks/helpdesk

# Evaluation harness
EVAL_PROVIDER=mock
EVAL_MIN_ACCURACY=0.7
EVAL_MIN_VALID_RATE=0.8
EVAL_MIN_COMPLETION_RATE=0.8
